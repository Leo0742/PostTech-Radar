# Локальный адрес приложения
PORT=8000

# Модель категорий: lite = Qwen3-Embedding-4B (по умолчанию), quality = Qwen3-Embedding-8B.
# Оба профиля используют pinned revision; quality остаётся доступен переключением одной переменной.
MODEL_PROFILE=lite

# Опционально: абсолютный путь к исходной выгрузке для собственных сценариев запуска.
# POSTTECH_DATASET=/absolute/path/to/requests.xlsx

# Внешние AI API не используются и ключи не требуются.
